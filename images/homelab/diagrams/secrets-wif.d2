# regenerate: d2 secrets-wif.d2 secrets-wif.svg
# Secrets & Workload Identity Federation — ADR-0010, User Story 1 LIVE.
# Dashed/grey = not built yet (User Story 2 / remaining work).

azuread-app: azuread_application\n+ service_principal\n(applied) {shape: rectangle}
fed-cred: Federated identity credential\ntrusts k3s issuer, subject =\nsystem:serviceaccount:external-secrets:eso-azure-kv\n(applied) {shape: rectangle}
k3s-oidc: k3s OIDC issuer\nhttps://k8s-oidc.<domain>\nk3s_configure_oidc_issuer: true {shape: rectangle}
oidc-static: oidc-discovery-static\nnginx serves cached\n/.well-known/openid-configuration\n+ /openid/v1/jwks\n(never proxies live apiserver) {shape: rectangle}
oidc-fetch: initContainer fetch\n(uses pod's own SA token —\nalready authorized via\nsystem:service-account-issuer-discovery) {shape: rectangle}
wi-webhook: azure-workload-identity webhook\n(deployed, azureTenantID set) {shape: rectangle}
eso-sa: eso-azure-kv ServiceAccount\n+ ClusterSecretStore azure-keyvault\n(Ready: True, validated) {shape: rectangle}
keyvault: Azure Key Vault kv-hl-example\ncentralus, homelab sub\n(RG + vault + role assignment) {shape: rectangle}
jellyfin-mcp: jellyfin-mcp namespace\nExternalSecret -> jellyfin-mcp-secret/api-key {shape: rectangle}
stock-mcp: stock-mcp namespace\nExternalSecret -> stock-mcp-secret/finnhub-key {shape: rectangle}
viktor-health-mcp: viktor-health-mcp namespace\nExternalSecret -> viktor-health-mcp-secret/google-health {shape: rectangle}
hermes-agent: hermes-agent namespace\nExternalSecret -> hermes-agent-<profile>-secret/discord-bot-token\n(one per profile, 8 total) {shape: rectangle}

azuread-app -> fed-cred
fed-cred -> k3s-oidc: trusts issuer
oidc-fetch -> oidc-static: seeds cache on pod start\n(in-cluster call, existing RBAC)
k3s-oidc -> oidc-fetch: apiserver's own\ndiscovery docs
oidc-static -> wi-webhook: Azure AD validates\nfederated credential\nagainst this endpoint
wi-webhook -> eso-sa: injects Azure identity
eso-sa -> keyvault: ClusterSecretStore\n(authenticated, Ready)
jellyfin-mcp -> eso-sa: ExternalSecret\nsecretStoreRef
stock-mcp -> eso-sa: ExternalSecret\nsecretStoreRef
viktor-health-mcp -> eso-sa: ExternalSecret\nsecretStoreRef
hermes-agent -> eso-sa: ExternalSecret\nsecretStoreRef

legend: "dashed/grey = not built yet\nsolid = deployed and live" {shape: text}
