# regenerate: d2 network.d2 network.svg
# Network topology — LAN nodes, k3s roles, MetalLB range, Cloudflare edge.

internet: Internet {shape: cloud}

cloudflare: Cloudflare Edge {
  shape: cloud
  tunnel-nas: tunnel-nas tunnel
  tunnel-k8s: tunnel-k8s tunnel
  wan-record: "nas.<domain> A-record\n(direct WAN, bypasses tunnel)"
}

internet -> cloudflare.tunnel-nas
internet -> cloudflare.tunnel-k8s
internet -> cloudflare.wan-record: "198.51.100.10" {style.stroke-dash: 3}

lan: LAN 10.10.0.0/24 {
  nas: NAS\n10.10.0.49\nUGOS Pro, own cloudflared {shape: rectangle}

  k3s: k3s cluster {
    gpu-node: gpu-node\n.44 — k3s server\nGPU: RTX 1060 6GB\nOllama (Ansible, NOT k8s) {shape: rectangle}
    exia: exia\n.55 — k3s agent {shape: rectangle}
    kyrios: kyrios\n.47 — k3s agent {shape: rectangle}
    dynames: dynames\n.41 — k3s agent {shape: rectangle}
    wing: wing\n.10 — pending join {shape: rectangle; style.stroke-dash: 3}
    deathscythe: deathscythe\n.11 — pending join {shape: rectangle; style.stroke-dash: 3}

    metallb: MetalLB pool\n.200–.220 {shape: rectangle}
    traefik: Traefik VIP\n.200 {shape: rectangle}

    metallb -> traefik
    gpu-node <-> exia: flannel vxlan
    gpu-node <-> kyrios: flannel vxlan
    gpu-node <-> dynames: flannel vxlan
  }
}

cloudflare.tunnel-nas -> lan.nas: cloudflared (Docker)
cloudflare.tunnel-k8s -> lan.k3s.traefik: cloudflared pod (all nodes)
